{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "experimentalServices": {
    "frontend": {
      "entrypoint": "frontend",
      "routePrefix": "/"
    },
    "backend": {
      "entrypoint": "api.py",
      "routePrefix": "/api",
      "excludeFiles": [
        "data/**",
        "docs/**",
        "frontend/**",
        "scripts/**",
        "sync/**",
        "tests/**"
      ]
    }
  },
  "routes": [
    {
      "src": "^/(?!api(?:/|$)|$|index\\.html$|assets/|favicon\\.svg$|manifest\\.webmanifest$|icon-(?:192|512)\\.png$|social-card\\.(?:png|svg)$|sw\\.js$|robots\\.txt$|sitemap\\.xml$|404\\.html$).*",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}
