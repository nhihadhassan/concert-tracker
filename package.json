{
  "name": "concert-tracker",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "npm ci --prefix frontend && npm run build --prefix frontend",
    "dev": "npm run dev --prefix frontend",
    "lint": "npm run lint --prefix frontend",
    "typecheck": "npm run typecheck --prefix frontend",
    "test:frontend": "npm run test:run --prefix frontend",
    "test:backend": ".venv/bin/python -m pytest",
    "format:check": ".venv/bin/python -m ruff format --check backend tests",
    "check": "npm run lint && npm run typecheck && npm run test:frontend && npm run test:backend && npm run format:check"
  },
  "engines": {
    "node": ">=24"
  }
}
